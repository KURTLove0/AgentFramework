  "acceptance_invariants": [
    "Grant/revoke requires the proof displayed to the user; current proposal, permission, status, cancellation and current task round are checked in one transaction.",
    "Permission, execution intent and acceptance receipt commit together or roll back together.",
    "Exact accepted replay does not renew or restore a revoked grant, revoke a later replacement, or dispatch a newer permission request.",
    "Queue saturation, service restart and process shutdown after executor handoff retain the continuation until actual execution progress settles it.",
    "Executor/worker failures require explicit retry; a retry remains queued when capacity is unavailable and preserves the grant deadline.",
    "Unknown results expose read-only review; replacement contents are adopted only through explicit review, while old callbacks cannot control a newer shared dialog."
  ],
  "limits": [
    "Ordinary grant/revoke clients must now send proof from the displayed permissions detail.",
    "UI recovery state is page-local; permission receipts and execution intent are durable server state.",
    "Revocation cannot undo an already in-flight action; existing runtime checks and reconciliation remain in force.",
    "Business tools remain simulated; no external models, package rebuild, deployment or version bump occurred.",
    "Historical verification manifests retain their original hashes rather than being rewritten after this increment."
  ],
